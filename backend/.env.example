# Copy this file to ".env" and fill in your real values. Never commit ".env" to git.

# Your MongoDB Atlas connection string
# Get this from Atlas dashboard -> Database -> Connect -> Drivers -> Node.js
# Replace <username>, <password>, and add a database name before the "?"
MONGO_URI=mongodb+srv://<username>:<password>@yourcluster.mongodb.net/myquickkart?retryWrites=true&w=majority

# Port the backend server runs on
PORT=5000

# Secret key used to sign JWT auth tokens (any long random string)
JWT_SECRET=replace_this_with_a_long_random_string
